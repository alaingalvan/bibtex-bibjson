{
  "name": "bibtex-bibjson",
  "version": "0.3.1",
  "description": "📚 A tool to convert BibTeX documents to and from BibJSON.",
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "typings": "dist/bibtex-bibjson.d.ts",
  "types": "dist/bibtex-bibjson.d.ts",
  "source": "src/bibtex-bibjson.js",
  "main": "dist/bibtex-bibjson.js",
  "module": "dist/bibtex-bibjson.module.js",
  "unpkg": "dist/bibtex-bibjson.umd.js",
  "exports": {
    "types": "./dist/bibtex-bibjson.d.ts",
    "default": "./dist/bibtex-bibjson.modern.js"
  },
  "scripts": {
    "build": "peggy -o src/bibtex-bibjson.js src/bibtex.pegjs && tsc --ignoreConfig --allowJs --declaration --emitDeclarationOnly --outDir dist src/bibtex-bibjson.js && tsx scripts/build.mts",
    "test": "ava tests/test.ts",
    "start": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaingalvan/bibtex-bibjson.git"
  },
  "keywords": [
    "transpiler",
    "compiler",
    "bibtex",
    "bibjson"
  ],
  "author": "Alain Galvan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alaingalvan/bibtex-bibjson/issues"
  },
  "homepage": "https://github.com/alaingalvan/bibtex-bibjson#readme",
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "tsx/cjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.x",
    "ava": "^8.4.x",
    "esbuild": "^0.28.2",
    "peggy": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
